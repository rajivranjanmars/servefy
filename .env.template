# Environment Variables Template
# Copy this file and fill in your actual values
# DO NOT commit the filled file to version control

# ==========================================
# CLOUDFLARE CONFIGURATION
# ==========================================

# Get this by running: wrangler account list
# Example: 1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# D1 Database ID (from: wrangler d1 create survey-db)
# Example: a1b2c3d4-e5f6-7890-abcd-ef1234567890
D1_DATABASE_ID=your-database-id-here

# D1 Database name used in Wrangler config
D1_DATABASE_NAME=survey-db

# R2 bucket names used in Wrangler config
R2_BUCKET_NAME=survey-files
R2_PREVIEW_BUCKET_NAME=survey-files-preview

# Optional per-environment deployment overrides
D1_DATABASE_NAME_STAGING=survey-db
D1_DATABASE_ID_STAGING=your-staging-database-id-here
R2_BUCKET_NAME_STAGING=survey-files
R2_PREVIEW_BUCKET_NAME_STAGING=survey-files-preview
FRONTEND_URL_STAGING=https://staging.example.pages.dev
TRUSTED_ORIGINS_STAGING=https://staging.example.pages.dev

D1_DATABASE_NAME_PRODUCTION=survey-db
D1_DATABASE_ID_PRODUCTION=your-production-database-id-here
R2_BUCKET_NAME_PRODUCTION=survey-files
R2_PREVIEW_BUCKET_NAME_PRODUCTION=survey-files-preview
FRONTEND_URL_PRODUCTION=https://your-production-domain.com
TRUSTED_ORIGINS_PRODUCTION=https://your-production-domain.com

# ==========================================
# BETTER AUTH CONFIGURATION
# ==========================================

# Generate with: openssl rand -base64 32
# Must be at least 32 characters
BETTER_AUTH_SECRET=generate-a-strong-secret-here

# Frontend URL (change for production)
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# AWS SES CONFIGURATION
# ==========================================

# AWS Access Key ID (from AWS IAM Console)
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# AWS Secret Access Key (from AWS IAM Console)
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Region (e.g., us-east-1, eu-west-1)
AWS_REGION=us-east-1

# Email address verified in AWS SES
# Must be verified before sending emails
SES_FROM_EMAIL=noreply@yourdomain.com

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# API URL for frontend
# Local: http://localhost:8787
# Production: https://your-worker.your-subdomain.workers.dev
VITE_API_URL=/api

# ==========================================
# NOTES
# ==========================================
# 
# 1. Never commit this file with real values
# 2. Keep secrets secure and rotate them regularly
# 3. Use different secrets for local and production
# 4. For production, use wrangler secrets instead of .dev.vars
#
# To set production secrets:
#   wrangler secret put BETTER_AUTH_SECRET
#   wrangler secret put AWS_ACCESS_KEY_ID
#   wrangler secret put AWS_SECRET_ACCESS_KEY
#

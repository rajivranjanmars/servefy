{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "http://localhost:3000",
          "https://surveys.r24.dev"
        ],
        "methods": ["GET", "PUT", "POST", "DELETE"],
        "headers": [
          "Content-Type",
          "Authorization",
          "X-Requested-With"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}

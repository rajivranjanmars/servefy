{
  "name": "@survey/worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "types:generate": "wrangler types",
    "types:check": "wrangler types --check",
    "check": "wrangler check",
    "tail": "wrangler tail",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.721.0",
    "@better-auth/expo": "^1.1.8",
    "@survey/database": "workspace:*",
    "@survey/types": "workspace:*",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.22",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "nanoid": "^5.1.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.12",
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "wrangler": "^3.100.0"
  }
}
